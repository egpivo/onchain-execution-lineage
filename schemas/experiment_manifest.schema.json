{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egpivo/dflow-transaction-lineage/schemas/experiment_manifest.schema.json",
  "title": "ExperimentManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "provider",
    "endpoint_type",
    "mode",
    "pair",
    "input_amount",
    "fixed_parameters",
    "treatment_variable",
    "treatment_values",
    "baseline_value",
    "maximum_request_count",
    "output_path",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "experiment_id": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "enum": ["dflow"] },
    "endpoint_type": {
      "type": "string",
      "enum": ["developer", "production", "app", "rpc"]
    },
    "mode": { "type": "string", "enum": ["fixture", "live"] },
    "pair": { "type": "string" },
    "input_amount": { "type": "string" },
    "fixed_parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "treatment_variable": {
      "type": "string",
      "enum": ["platform_fee_bps", "slippage_bps", "input_amount"]
    },
    "treatment_values": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "type": ["string", "number"] }
    },
    "baseline_value": { "type": ["string", "number"] },
    "maximum_request_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "output_path": { "type": "string" },
    "fixture_dir": { "type": ["string", "null"] },
    "endpoint_hostname": { "type": ["string", "null"] },
    "endpoint_path": {
      "type": "string",
      "enum": ["quote", "order"],
      "default": "quote"
    },
    "user_public_key": { "type": ["string", "null"] },
    "user_public_key_env": { "type": ["string", "null"] },
    "notes": { "type": "string" }
  }
}
